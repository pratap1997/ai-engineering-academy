# OmniRoute Configuration for AI Engineering Academy
# Unified AI Gateway — Token-Optimized Routing

# =============================================================
# HOW IT WORKS
# =============================================================
# OmniRoute acts as a local proxy on http://localhost:4000
# It exposes an OpenAI-compatible endpoint that:
#   1. Routes requests across 290+ AI providers
#   2. Falls back to free models when quota is hit
#   3. Compresses prompts 15-95% with RTK+Caveman compression
#   4. Monitors live usage in a web dashboard

# =============================================================
# QUICK START
# =============================================================
# cd tools/omni-route
# npm install
# npm start
#
# Then set in any AI tool:
#   API Base URL: http://localhost:4000/v1
#   API Key:      omni-local (or any string)

# =============================================================
# MODEL ROUTING PRIORITY (for Academy sessions)
# =============================================================
# 1. PRIMARY:  gemini-2.5-pro (large context, fast, free tier)
# 2. FALLBACK: claude-3-5-haiku (fast, cheap, great for code)
# 3. FREE:     deepseek-chat (free, strong reasoning)
# 4. FREE:     kimi-k1.5 (free, long context)

GATEWAY_HOST=localhost
GATEWAY_PORT=4000
DEFAULT_MAX_TOKENS=32000
ENABLE_RTK_COMPRESSION=true
ENABLE_CAVEMAN_COMPRESSION=true
TOKEN_COMPRESSION_TARGET=0.4
LOG_REQUESTS=true
DASHBOARD_PORT=4001
